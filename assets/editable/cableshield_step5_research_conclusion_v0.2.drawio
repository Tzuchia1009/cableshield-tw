<mxfile host="app.diagrams.net" modified="2026-09-18T06:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="cableshield-step5-v02" name="Step 5 研究結論">
    <mxGraphModel dx="1654" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="2" value="研究結論：本團隊聚焦既有告警之後的查核流程" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=36;fontStyle=1;fontColor=#003B5C;" vertex="1" parent="1"><mxGeometry x="85" y="42" width="1484" height="58" as="geometry"/></mxCell>
        <mxCell id="3" value="先承認現有監控基礎，再說明常見解法的限制、本研究補位與待驗證範圍" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=22;fontColor=#3D5663;" vertex="1" parent="1"><mxGeometry x="120" y="103" width="1414" height="40" as="geometry"/></mxCell>
        <mxCell id="10" value="官方背景" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#FFFFFF;strokeColor=#8C1D40;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=21;fontStyle=1;fontColor=#8C1D40;" vertex="1" parent="1"><mxGeometry x="175" y="166" width="210" height="54" as="geometry"/></mxCell>
        <mxCell id="11" value="111–114 年海纜障礙 34 起&lt;br&gt;本研究換算約 43 天／起" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#FFFFFF;strokeColor=#8C1D40;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=20;fontColor=#3D5663;spacing=8;" vertex="1" parent="1"><mxGeometry x="385" y="166" width="450" height="80" as="geometry"/></mxCell>
        <mxCell id="12" value="研究工作量" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#FFFFFF;strokeColor=#006A71;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=21;fontStyle=1;fontColor=#006A71;" vertex="1" parent="1"><mxGeometry x="845" y="166" width="210" height="54" as="geometry"/></mxCell>
        <mxCell id="13" value="G0 日中位數 656.5 筆，約 657 筆&lt;br&gt;屬研究候選，並非官方告警量" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#FFFFFF;strokeColor=#006A71;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=20;fontColor=#3D5663;spacing=8;" vertex="1" parent="1"><mxGeometry x="1055" y="166" width="450" height="80" as="geometry"/></mxCell>
        <mxCell id="20" value="既有系統的基礎" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#FFFFFF;strokeColor=#003B5C;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=25;fontStyle=1;fontColor=#003B5C;" vertex="1" parent="1"><mxGeometry x="80" y="315" width="450" height="68" as="geometry"/></mxCell>
        <mxCell id="21" value="&lt;b&gt;AIS・VTS・SAWS・跨機關機制&lt;/b&gt;&lt;br&gt;&lt;br&gt;• 即時監測、告警與通報&lt;br&gt;• 正式權限與應變流程&lt;br&gt;• 掌握研究原型無法取得的場域資訊&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#586B75&quot;&gt;公開資料不足以確認全部後告警功能，本團隊不對內部系統下結論。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;arcSize=10;fillColor=#FFFFFF;strokeColor=#A8BCC5;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=19;fontColor=#243A46;spacingTop=20;spacingLeft=22;spacingRight=18;" vertex="1" parent="1"><mxGeometry x="80" y="388" width="450" height="280" as="geometry"/></mxCell>
        <mxCell id="22" value="常見解法的限制" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#FFFFFF;strokeColor=#8C1D40;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=25;fontStyle=1;fontColor=#8C1D40;" vertex="1" parent="1"><mxGeometry x="602" y="315" width="450" height="68" as="geometry"/></mxCell>
        <mxCell id="23" value="&lt;b&gt;人工逐案查核&lt;/b&gt;：大量跨源比對占用時間&lt;br&gt;&lt;br&gt;&lt;b&gt;單一靜態規則&lt;/b&gt;：資料稀疏與完整事件容易混在同一清單&lt;br&gt;&lt;br&gt;&lt;b&gt;單一模型分數&lt;/b&gt;：缺口、反證與模型分歧容易被數值掩蓋&lt;br&gt;&lt;br&gt;&lt;b&gt;自動處置&lt;/b&gt;：證據強度、權限與責任邊界仍需釐清" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;arcSize=10;fillColor=#FFFFFF;strokeColor=#A8BCC5;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=19;fontColor=#243A46;spacingTop=20;spacingLeft=22;spacingRight=18;" vertex="1" parent="1"><mxGeometry x="602" y="388" width="450" height="280" as="geometry"/></mxCell>
        <mxCell id="24" value="本研究補上的流程" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#FFFFFF;strokeColor=#006A71;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=25;fontStyle=1;fontColor=#006A71;" vertex="1" parent="1"><mxGeometry x="1124" y="315" width="450" height="68" as="geometry"/></mxCell>
        <mxCell id="25" value="&lt;b&gt;G1 品質門檻&lt;/b&gt;：先判斷資料能否解讀&lt;br&gt;&lt;br&gt;&lt;b&gt;K 可調&lt;/b&gt;：依人數、工時與單案時間設定深查量&lt;br&gt;&lt;br&gt;&lt;b&gt;證據卡與棄答&lt;/b&gt;：呈現理由、反證、缺口及模型分歧&lt;br&gt;&lt;br&gt;&lt;b&gt;人工覆核與留痕&lt;/b&gt;：人員完成判斷、處置並承擔權責" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;arcSize=10;fillColor=#FFFFFF;strokeColor=#006A71;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=19;fontColor=#243A46;spacingTop=20;spacingLeft=22;spacingRight=18;" vertex="1" parent="1"><mxGeometry x="1124" y="388" width="450" height="280" as="geometry"/></mxCell>
        <mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6A7D86;strokeWidth=3;" edge="1" parent="1" source="21" target="23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6A7D86;strokeWidth=3;" edge="1" parent="1" source="23" target="25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="30" value="目前證據支持" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#FFFFFF;strokeColor=#006A71;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=23;fontStyle=1;fontColor=#006A71;" vertex="1" parent="1"><mxGeometry x="120" y="725" width="650" height="62" as="geometry"/></mxCell>
        <mxCell id="31" value="研究工作量與品質分流可重現&lt;br&gt;G1：23,690 筆可進模型；628,039 筆需補證&lt;br&gt;已完成可調 K、證據卡、棄答與人工覆核原型" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#FFFFFF;strokeColor=#A8BCC5;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=19;fontColor=#243A46;spacing=10;" vertex="1" parent="1"><mxGeometry x="120" y="792" width="650" height="130" as="geometry"/></mxCell>
        <mxCell id="32" value="仍待授權後驗證" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#FFFFFF;strokeColor=#8C1D40;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=23;fontStyle=1;fontColor=#8C1D40;" vertex="1" parent="1"><mxGeometry x="884" y="725" width="650" height="62" as="geometry"/></mxCell>
        <mxCell id="33" value="只讀影子模式，不改變正式處置&lt;br&gt;每案查核時間・Recall@K・人工覆寫率・補證完成率&lt;br&gt;目前不主張已證實減勞或提高事故偵測率" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#FFFFFF;strokeColor=#A8BCC5;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=19;fontColor=#243A46;spacing=10;" vertex="1" parent="1"><mxGeometry x="884" y="792" width="650" height="130" as="geometry"/></mxCell>
        <mxCell id="40" value="既有監控提供重要基礎；本研究補充候選形成後的資料可判性、優先順序、證據缺口與人工覆核流程。" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=10;fillColor=#FFFFFF;strokeColor=#003B5C;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=23;fontStyle=1;fontColor=#003B5C;spacing=15;" vertex="1" parent="1"><mxGeometry x="115" y="972" width="1424" height="78" as="geometry"/></mxCell>
        <mxCell id="41" value="資料邊界：34 起為官方障礙紀錄；657 為 G0 研究候選日中位數；K 為人工深查量能參數。" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=17;fontColor=#586B75;" vertex="1" parent="1"><mxGeometry x="130" y="1066" width="1394" height="35" as="geometry"/></mxCell>
        <mxCell id="42" value="FrontFish｜CableShield-TW｜Step 5 研究結論圖 v0.2" style="text;html=1;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#7A8B93;" vertex="1" parent="1"><mxGeometry x="970" y="1110" width="570" height="26" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
