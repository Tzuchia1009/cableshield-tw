<mxfile host="app.diagrams.net" modified="2026-09-18T12:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="step4-alternatives" name="替代方案排除">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Step 4｜替代方案排除：選擇任務位置，而非宣稱取代既有系統" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=27;fontStyle=1;fontColor=#18324A;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1450" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="高價值情境：監控已存在、候選超過深查量能、資料品質不一、最終責任必須由人承擔。" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=17;fontColor=#486579;" vertex="1" parent="1"><mxGeometry x="50" y="75" width="1450" height="35" as="geometry"/></mxCell>

        <mxCell id="p1" value="既有監控與正式機制&#xa;AIS｜VTS｜SAWS｜跨機關應變&#xa;&#xa;強項：即時資料、權限、通報與處置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E5A78;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=18;fontStyle=1;fontColor=#18324A;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="390" height="175" as="geometry"/></mxCell>
        <mxCell id="p2" value="CableShield-TW 後告警唯讀查核層&#xa;&#xa;G1 品質門檻｜K 可調｜多模型分歧&#xa;證據卡｜棄答｜審計留痕" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A7F78;strokeWidth=4;fontFamily=Microsoft JhengHei;fontSize=19;fontStyle=1;fontColor=#18324A;" vertex="1" parent="1"><mxGeometry x="625" y="135" width="405" height="205" as="geometry"/></mxCell>
        <mxCell id="p3" value="正式人員與機關流程&#xa;查核｜定性｜處置｜權責&#xa;&#xa;輸出語意：值得優先查核" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1E2B;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=18;fontStyle=1;fontColor=#3E1B22;" vertex="1" parent="1"><mxGeometry x="1195" y="150" width="390" height="175" as="geometry"/></mxCell>
        <mxCell id="e1" value="候選／告警" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2A7F78;strokeWidth=4;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#18324A;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Top-K 證據卡" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#7B1E2B;strokeWidth=4;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#3E1B22;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="criterion" value="評審四問｜① 候選是否超過深查量能？　② 資料是否足以解讀？　③ 為何先查這些？　④ 最後由誰負責？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#C7952D;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=17;fontStyle=1;fontColor=#6A5320;" vertex="1" parent="1"><mxGeometry x="255" y="370" width="1145" height="65" as="geometry"/></mxCell>

        <mxCell id="a" value="A｜維持現狀&#xa;最強：即時、正式、成熟。&#xa;邊界：公開資料無法確認是否已有完整的 K、品質分流、證據卡與稽核。&#xa;本案角色：以只讀層補上可驗證的查核介面。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E5A78;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="70" y="480" width="470" height="220" as="geometry"/></mxCell>
        <mxCell id="b" value="B｜擴充人工查核&#xa;最強：情境判斷與責任清楚。&#xa;邊界：每日約 657 筆研究候選下，重複查找與跨源對齊占用時間。&#xa;本案角色：機器做前處理，人員做查核與決策。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A7F78;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="590" y="480" width="470" height="220" as="geometry"/></mxCell>
        <mxCell id="c" value="C｜單一靜態規則&#xa;最強：透明、快速、低成本。&#xa;邊界：品質不一時，資料足夠與需補證事件會混在同一清單。&#xa;本案角色：規則保留為基準，前置 G1 品質門檻。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E5A78;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1110" y="480" width="470" height="220" as="geometry"/></mxCell>
        <mxCell id="d" value="D｜單一 AI 高分&#xa;最強：多變量、可規模化。&#xa;邊界：異常不等於惡意；模型會分歧，缺測也不會自動變成證據。&#xa;本案角色：呈現共識、分歧、缺口與下一步。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A7F78;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="70" y="750" width="470" height="220" as="geometry"/></mxCell>
        <mxCell id="e" value="E｜全自動處置&#xa;最強：快速、一致。&#xa;邊界：高後果事件涉及權責、證據與行政程序。&#xa;本案角色：AI 只做排序與提示；人員完成查核、定性與處置。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3433E;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#3E1B22;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="590" y="750" width="470" height="220" as="geometry"/></mxCell>
        <mxCell id="f" value="F｜重建整合平台&#xa;最強：深度客製、統一管理。&#xa;邊界：採購、資安、權限與串接成本高，可能重複現有建設。&#xa;本案角色：先交付可嵌入的最小證據模組。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7B1E2B;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=15;fontColor=#3E1B22;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="1110" y="750" width="470" height="220" as="geometry"/></mxCell>

        <mxCell id="footer" value="結論｜優勢來自特定任務契合度：把「工作量 → 可判性 → K → 證據 → 人員決定」接成可稽核資料流。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A7F78;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=17;fontStyle=1;fontColor=#18324A;" vertex="1" parent="1"><mxGeometry x="195" y="1000" width="1260" height="65" as="geometry"/></mxCell>
        <mxCell id="stages" value="採用路徑｜離線研究原型（已完成） → 只讀影子模式（授權後驗證） → 有限介接（通過成效與治理檢查後）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#C7952D;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=16;fontStyle=1;fontColor=#6A5320;" vertex="1" parent="1"><mxGeometry x="260" y="1080" width="1130" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
