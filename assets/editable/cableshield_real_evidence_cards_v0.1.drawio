        <mxCell id="title" value="CableShield-TW｜真實研究資料證據卡" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=28;fontStyle=1;fontColor=#18324A;" vertex="1" parent="1"><mxGeometry x="55" y="28" width="1050" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="同一套治理規則，同時處理「可進排序」與「資料不足需補證」；分數只代表查核優先度。" style="text;html=1;strokeColor=none;fillColor=none;align=left;whiteSpace=wrap;fontFamily=Microsoft JhengHei;fontSize=17;fontColor=#486579;" vertex="1" parent="1"><mxGeometry x="55" y="77" width="1300" height="35" as="geometry"/></mxCell>

        <mxCell id="cardA" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2A7F78;strokeWidth=3;arcSize=8;" vertex="1" parent="1"><mxGeometry x="55" y="140" width="720" height="815" as="geometry"/></mxCell>
        <mxCell id="headA" value="A｜可進排序的封存事件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF6F3;strokeColor=#2A7F78;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=22;fontStyle=1;fontColor=#18324A;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="55" y="140" width="720" height="70" as="geometry"/></mxCell>
        <mxCell id="a1" value="事件與來源&#xa;2025-01-01 / 8cb5df5e027c26b1 / tg-apcn-2&#xa;來源：frozen_2025_daily_top5.csv｜證據帳本 E008" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9BC6BF;fontFamily=Microsoft JhengHei;fontSize=16;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="85" y="235" width="660" height="120" as="geometry"/></mxCell>
        <mxCell id="a2" value="觀測品質與空間資訊&#xa;3 筆 AIS｜時間跨度 7.0 小時｜符合 G1 資格&#xa;距 APCN-2 公開概化代理線 0.702 km；不等於實際海纜淨距" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9BC6BF;fontFamily=Microsoft JhengHei;fontSize=16;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="85" y="380" width="660" height="115" as="geometry"/></mxCell>
        <mxCell id="a3" value="排序訊號&#xa;當日第 3｜ensemble score 0.533&#xa;理由碼：低速比例偏低、船纜距離變動偏高、與纜線交角偏高" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9BC6BF;fontFamily=Microsoft JhengHei;fontSize=16;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="85" y="510" width="660" height="115" as="geometry"/></mxCell>
        <mxCell id="a4" value="缺少證據&#xa;精確海纜幾何、高頻 AIS、錨是否下水、海況、權威事件結果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#C7952D;fontFamily=Microsoft JhengHei;fontSize=16;fontColor=#6A5320;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="85" y="650" width="660" height="90" as="geometry"/></mxCell>
        <mxCell id="a5" value="允許結論｜可進入人工查核順位&#xa;禁止推論｜事故、違法、故意或責任歸屬" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6F3;strokeColor=#A3433E;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=17;fontStyle=1;fontColor=#742F2B;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="85" y="775" width="660" height="115" as="geometry"/></mxCell>

        <mxCell id="cardB" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A3433E;strokeWidth=3;arcSize=8;" vertex="1" parent="1"><mxGeometry x="835" y="140" width="720" height="815" as="geometry"/></mxCell>
        <mxCell id="headB" value="B｜公開事故回溯的棄權事件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EBEA;strokeColor=#A3433E;strokeWidth=3;fontFamily=Microsoft JhengHei;fontSize=22;fontStyle=1;fontColor=#3E1B22;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="835" y="140" width="720" height="70" as="geometry"/></mxCell>
        <mxCell id="b1" value="事件與來源&#xa;INC_20250103_TPE｜2025-01-03｜代理線 APCN-2&#xa;來源：known_incident_abstention_audit.csv｜證據帳本 E009" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D2AAA7;fontFamily=Microsoft JhengHei;fontSize=16;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="865" y="235" width="660" height="120" as="geometry"/></mxCell>
        <mxCell id="b2" value="觀測品質&#xa;事故窗內只有 1 筆 AIS，未達 3 點門檻&#xa;模型資格：false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D2AAA7;fontFamily=Microsoft JhengHei;fontSize=16;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="865" y="380" width="660" height="115" as="geometry"/></mxCell>
        <mxCell id="b3" value="系統處置&#xa;abstain_insufficient_sequence&#xa;不產生查核優先分數；資料缺少不能解讀為低風險" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D2AAA7;fontFamily=Microsoft JhengHei;fontSize=16;fontColor=#18324A;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="865" y="510" width="660" height="115" as="geometry"/></mxCell>
        <mxCell id="b4" value="缺少證據&#xa;事故前高頻 AIS、精確海纜幾何、雷達／VTS、正式調查資料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E8;strokeColor=#C7952D;fontFamily=Microsoft JhengHei;fontSize=16;fontColor=#6A5320;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="865" y="650" width="660" height="90" as="geometry"/></mxCell>
        <mxCell id="b5" value="允許結論｜品質閘門依預定規則執行，事件進入補證佇列&#xa;禁止推論｜提前命中、肇因或主觀意圖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6F3;strokeColor=#A3433E;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=17;fontStyle=1;fontColor=#742F2B;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="865" y="775" width="660" height="115" as="geometry"/></mxCell>

        <mxCell id="footer" value="共同責任邊界｜可判讀事件取得查核順位；資料不足事件保留棄權理由並進入補證。兩者皆可回到封存 artifact 與證據帳本。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E5A78;strokeWidth=2;fontFamily=Microsoft JhengHei;fontSize=17;fontStyle=1;fontColor=#18324A;" vertex="1" parent="1"><mxGeometry x="225" y="995" width="1160" height="78" as="geometry"/></mxCell>
